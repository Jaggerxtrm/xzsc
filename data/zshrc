    echo "  tw           new window"
    echo "  tsp          split vertical (↕)"
    echo "  tsh          split horizontal (↔)"
    echo "  ttheme <theme> [bar]  apply theme; bar = theme(default)/transparent/dark/inverse"
    echo ""
    echo "  DARK THEMES (accent colors)"
    echo "  ────────────────────────────────────"
    echo "  black (#000000)     transparent (terminal bg)"
    echo "  graphite (neutral)"
    echo "  cobalt (#5f87a8)    green/code (#98c379)"
    echo "  green2 (#004d27)"
    echo "  blue (#0b2a5b)      purple (#32104d)"
    echo "  red (#4a1010)       orange bg (#5b2c0b)"
    echo "  nord (#88c0d0)"
    echo "  everforest (#a7c080) gruvbox (#fabd2f)"
    echo ""
    echo "  LIGHT THEMES (same accents)"
    echo "  ────────────────────────────────────"
    echo "  paper (neutral)     lcobalt"
